# SQLite (로컬 기본)
DATABASE_URL=sqlite:///./vote.db
# Postgres는 동기 URL만. postgresql+asyncpg 는 쓰지 않는다.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/vote
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 로컬 dev
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# EC2 (Nginx로 프론트+API 같은 도메인이면 실제 접속 URL 추가)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_EC2_IP_OR_DOMAIN
MEDIA_DIR=./uploads
# S3 + CloudFront (운영 권장). 설정 시 presigned URL 업로드
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=your-bucket
S3_KEY_PREFIX=vote
# 도메인만 (https 포함). /vote 경로는 S3_KEY_PREFIX 가 붙입니다
CLOUDFRONT_URL=https://dyqy5h9oxlxg8.cloudfront.net
# EC2: 빌드된 프론트 경로 지정 시 uvicorn 한 곳에서 API+화면 동시 서빙
# FRONTEND_DIST=../vote_frontend/dist
# 목업 투표(#42 등) 자동 생성. 미설정 시 SQLite에서만 true, PostgreSQL 등에서는 false
# SEED_MOCK_DATA=true

# AUTH_MODE=local | oidc | both  (기본 oidc = 회사 계정만)
AUTH_MODE=oidc
KEYCLOAK_ISSUER=https://auth.example.com/realms/your-realm
KEYCLOAK_CLIENT_ID=
# confidential 클라이언트면 시크릿. public이면 비워 둠.
# KEYCLOAK_CLIENT_SECRET=
# 앱 접근 역할. 비우면 회사 계정만으로 투표/폼 생성 가능. 전역 관리자가 아님.
# KEYCLOAK_ADMIN_ROLE=vote-admin
KEYCLOAK_ADMIN_ROLE=